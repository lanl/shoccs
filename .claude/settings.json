{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/gh/**)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(*--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *-t*)",
      "Bash(git credential fill*)",
      "Bash(git credential-osxkeychain*)",
      "Bash(security find-generic-password*)",
      "Bash(security find-internet-password*)",
      "Bash(security dump-keychain*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh run delete*)",
      "Bash(gh release delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh ssh-key add*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh gpg-key add*)",
      "Bash(gh gpg-key delete*)",
      "Bash(gh alias set*)",
      "Bash(gh alias import*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *variables*)",
      "Bash(gh api */merge*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *deleteRepository*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *addPullRequestReview*)",
      "Bash(gh api *enablePullRequestAutoMerge*)",
      "Bash(git push --mirror*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push *--prune*)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git push upstream*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--all*)",
      "Bash(git push *+*)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(gh api graphql*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr close*)",
      "Bash(gh pr reopen*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue transfer*)",
      "Bash(gh issue lock*)",
      "Bash(gh issue pin*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "Bash(gh repo create*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo sync*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh label delete*)",
      "Bash(gh label clone*)",
      "Bash(gh gist *)",
      "Bash(gh extension install*)",
      "Bash(gh config set*)",
      "Bash(gh cache delete*)",
      "Bash(gh codespace *)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth switch*)",
      "Bash(gh auth setup-git*)",
      "Bash(docker)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(podman *)",
      "Bash(make build*)",
      "Bash(make shell*)",
      "Bash(make clean*)",
      "Bash(./run-dev-container.fish*)",
      "Bash(fish *run-dev-container.fish*)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/.github/actions/**)",
      "Edit(**/.devcontainer/**)",
      "Edit(**/run-dev-container.fish)",
      "Edit(**/Makefile)",
      "Edit(**/local.mk)",
      "Edit(**/.envrc)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.local/share/uv",
        "~/.cache/ccache"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "codeload.github.com",
        "pypi.org",
        "files.pythonhosted.org",
        "download.pytorch.org",
        "download-r2.pytorch.org"
      ]
    }
  }
}
